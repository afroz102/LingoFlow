<?xml version="1.0" encoding="utf-8"?>
<!--
    The backend provider uses two normal network permissions —
    INTERNET to call the translation endpoint, ACCESS_NETWORK_STATE for the pre-flight offline check in cloud/
    AndroidConnectivityChecker. Everything else from the Gate 0 pass criteria still holds: no
    Accessibility, no overlay, no IME, no background service, no dangerous permission.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        android:forceQueryable is deliberately NOT set here. docs/TECHNICAL_PLAN.md /
        docs/VALIDATION_PLAN.md §2.2 call for testing it only as a one-off spike experiment (does it
        change discovery from a host without the <queries> declaration?), weighed against making
        this app broadly visible to every other installed app — not adopting it as a default.
    -->
    <application
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.InstantTranslate"
        android:supportsRtl="true">

        <!--
            Text-action adapter (docs/TECHNICAL_PLAN.md).
            The only externally exported component. No launcher intent filter —
            this build is reached exclusively through the Process Text selection menu.
        -->
        <activity
            android:name=".textaction.ProcessTextActivity"
            android:exported="true"
            android:theme="@style/Theme.InstantTranslate.Trampoline"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="@string/process_text_action_label">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
            Result presenter (ui/). Not exported — reachable only from ProcessTextActivity
            via an explicit intent carrying sanitized text, never from outside the app.
        -->
        <activity
            android:name=".ui.ResultActivity"
            android:exported="false"
            android:theme="@style/Theme.InstantTranslate.Dialog"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
