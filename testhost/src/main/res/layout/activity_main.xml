<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Fixture 1: selectable read-only TextView -->
        <TextView
            style="?attr/textAppearanceTitleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fixture_readonly_textview" />

        <TextView
            android:id="@+id/text_readonly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/fixture_readonly_sample"
            android:textIsSelectable="true" />

        <!-- Fixture 2: editable single-line EditText -->
        <TextView
            style="?attr/textAppearanceTitleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fixture_single_line_edittext" />

        <EditText
            android:id="@+id/edit_single_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:inputType="text"
            android:text="Editable single line: aap kaise ho?" />

        <!-- Fixture 3: editable multiline EditText -->
        <TextView
            style="?attr/textAppearanceTitleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fixture_multiline_edittext" />

        <EditText
            android:id="@+id/edit_multiline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:text="@string/fixture_multiline_sample" />

        <!-- Fixture 4: password field (negative case) -->
        <TextView
            style="?attr/textAppearanceTitleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fixture_password_edittext" />

        <EditText
            android:id="@+id/edit_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:inputType="textPassword"
            android:text="hunter2hunter2" />

        <!-- Fixture 5: Compose text surface -->
        <TextView
            style="?attr/textAppearanceTitleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fixture_compose_surface" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/compose_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp" />

        <!-- Fixture 6: WebView-hosted selectable text -->
        <TextView
            style="?attr/textAppearanceTitleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fixture_webview" />

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="20dp" />

        <!-- Fixture 7: deliberately custom selection implementation (negative/control case) -->
        <TextView
            style="?attr/textAppearanceTitleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fixture_custom_selection" />

        <com.lingoflow.instanttranslate.testhost.CustomSelectionTextView
            android:id="@+id/custom_selection_view"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="20dp"
            tools:text="@string/fixture_custom_selection_sample" />

    </LinearLayout>

</ScrollView>
